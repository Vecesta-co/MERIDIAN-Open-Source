# MERIDIAN Backend Local Development Environment
# This file is for LOCAL DEVELOPMENT ONLY. Never commit real secrets.

# Application
APP_NAME=meridian
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# Database — SQLite for local dev (no Postgres required)
DATABASE_URL=sqlite+aiosqlite:///./meridian_dev.db
DATABASE_URL_SYNC=sqlite:///./meridian_dev.db

# Redis (not used in Phase 1, placeholder)
REDIS_URL=

# Security
SECRET_KEY=dev-only-change-me
API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
