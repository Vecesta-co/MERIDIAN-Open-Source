# =============================================================================
# MERIDIAN — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file to version control.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=meridian
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database (Postgres/Supabase) ─────────────────────────────────────────────
# Use asyncpg driver for async operations
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meridian
# Sync URL for migrations and admin tools
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/meridian
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis (optional, for future task queue) ──────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────────────────────────────
# Change this in production to a strong random value
SECRET_KEY=change-me-in-production
# API key for external integrations (optional for MVP)
# API_KEY=your-api-key-here

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ️ Integration Bus (Phase 8)
# Shared secret for N8N webhook authentication. Must match
# MERIDIAN_WEBHOOK_SECRET in the backend config.
MERIDIAN_WEBHOOK_SECRET=your-n8n-webhook-secret-here
